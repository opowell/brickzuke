{
  "manifest_version": 3,
  "name": "BrickZuke",
  "version": "1.5",
  "icons": {
    "32": "images/32x32.png"
  },
  "host_permissions": [
    "https://*.bricklink.com/*",
    "https://www.lego.com/*"
  ],
  "content_scripts": [
    {
      "js": ["scripts/content.js"],
      "matches": [
        "http://localhost:5173/*",
        "https://localhost:5173/*",
        "https://www.brickzuke.com/*"
      ]
    }
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "description": "Fetches and scrapes BrickLink catalog data, and LEGO.com prices, on behalf of the BrickZuke web app."
}
