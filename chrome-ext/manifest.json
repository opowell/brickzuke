{
  "manifest_version": 3,
  "name": "BrickZuke",
  "version": "1.5",
  "icons": {
    "32": "images/32x32.png"
  },
  "host_permissions": [
    "https://*.bricklink.com/*",
    "https://www.lego.com/*"
  ],
  "content_scripts": [
    {
      "js": ["scripts/content.js"],
      "matches": [
        "http://localhost/*",
        "https://localhost/*",
        "https://www.brickzuke.com/*"
      ]
    }
  ],
  "background": {
    "service_worker": "service-worker.js",
    "scripts": ["service-worker.js"],
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "brickzuke@opowell",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "description": "Fetches and scrapes BrickLink catalog data, and LEGO.com prices, on behalf of the BrickZuke web app."
}
